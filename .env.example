# ==============================================================================
# MediFusion AI — Master Environment Configuration Template
# ==============================================================================
# This template documents environment variables across Backend and Frontend.
# MediFusion AI organizes environment configuration per service:
# - Backend environment: ./Backend/.env
# - Frontend environment: ./Frontend/.env
# NEVER commit real credentials, service-role keys, or database passwords to Git.

# ==============================================================================
# 1. BACKEND CONFIGURATION (Backend/.env)
# ==============================================================================
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PROJECT_NAME="MediFusion AI Backend"
API_V1_STR=/api/v1

# Supabase Credentials (Backend requires service role key for admin privileges)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Google Gemini API Key (Multimodal Synthesis & Agent Reasoning)
GEMINI_API_KEY=your-gemini-api-key-here

# ==============================================================================
# 2. FRONTEND CONFIGURATION (Frontend/.env)
# ==============================================================================
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# ONLY public/anon keys belong here. NEVER place service role keys here.
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME="MediFusion AI"
VITE_APP_DESCRIPTION="Multimodal Clinical Intelligence with Adaptive AI Orchestration"

# Supabase Public Client Credentials
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
