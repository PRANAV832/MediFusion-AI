# ==============================================================================
# MediFusion AI — Master .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets, Credentials & Environment Files
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Explicitly whitelist example templates
!.env.example
!frontend/.env.example
!backend/.env.example
!Frontend/.env.example
!Backend/.env.example

# ------------------------------------------------------------------------------
# 2. Package Dependencies & Virtual Environments
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
.venv/
*/.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Python Bytecode & Compilation Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg/
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg

# ------------------------------------------------------------------------------
# 4. Testing, Coverage & Linters
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.pyre/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 5. Frontend & Build Outputs
# ------------------------------------------------------------------------------
Frontend/dist/
Frontend/dist-ssr/
Frontend/.vite/
dist/
dist-ssr/
.vite/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 6. Medical Images, Uploads, Runtime Storage & Local Data
# ------------------------------------------------------------------------------
uploads/
*/uploads/
storage/
*/storage/
logs/
*/logs/
*.log
*.sqlite
*.sqlite3
*.db
scratch/

# Medical imaging and clinical formats (PHI protection)
*.dcm
*.dicom
*.nii
*.nii.gz
*.mha
*.mhd

# ------------------------------------------------------------------------------
# 7. AI Model Weights, Checkpoints & Large Data
# ------------------------------------------------------------------------------
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.ckpt
*.h5
*.pkl
models_data/
*/models_data/
.cache/
cache/

# ------------------------------------------------------------------------------
# 8. Docker Overrides & Local Configurations
# ------------------------------------------------------------------------------
docker-compose.override.yml
docker-compose*.local.yml

# ------------------------------------------------------------------------------
# 9. IDE, Editor & OS Generated Files
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# 10. Documentation Files (Ignore .md files except README.md and RUN_PROJECT.md)
# ------------------------------------------------------------------------------
*.md
!README.md
!readme.md
!**/README.md
!**/readme.md
!RUN_PROJECT.md
!run_project.md
!**/RUN_PROJECT.md
!**/run_project.md



