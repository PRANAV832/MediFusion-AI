# ==============================================================================
# MediFusion AI — Frontend Environment Template (.env.example)
# ==============================================================================
# Copy this file to Frontend/.env and populate with your local/project endpoints.
# All frontend variables must begin with VITE_ to be exposed to Vite client build.
# NEVER place secret service-role keys or database credentials in this file.

VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME="MediFusion AI"
VITE_APP_DESCRIPTION="Multimodal Clinical Intelligence with Adaptive AI Orchestration"

# Supabase Client Configuration (Public/Anon Key Only)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
